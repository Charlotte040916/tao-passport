{
  "name": "tao-passport",
  "version": "0.1.0",
  "private": true,
  "description": "Universal reputation and achievement passport for Bittensor TAO wallets.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend & npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "bittensor",
    "tao",
    "reputation",
    "passport",
    "gittensor"
  ],
  "license": "MIT"
}
